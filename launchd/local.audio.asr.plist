<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.audio.asr</string>
	<!-- Whisper-tjänst (tal till text) på 127.0.0.1:8092. Används av dikteringen (rost/diktera_rec.py).
	     Standardmodell: ASR_MODEL (KB-Whisper). En modell i minnet åt gången, ~3.5 GB för large (float16, MPS).
	     Logg: ~/Library/Logs/audio-asr.log
	     Stoppa:  launchctl bootout gui/$(id -u)/local.audio.asr
	     Starta:  launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/local.audio.asr.plist -->
	<key>ProgramArguments</key>
	<array>
		<string>__VENV__/bin/python</string>
		<string>__REPO__/rost/asr_server.py</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HF_HUB_OFFLINE</key>
		<string>1</string>
		<key>TRANSFORMERS_OFFLINE</key>
		<string>1</string>
		<key>ASR_MODEL</key>
		<string>__MODEL__</string>
		<key>ASR_PORT</key>
		<string>8092</string>
	</dict>
	<key>WorkingDirectory</key>
	<string>__REPO__/rost</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/audio-asr.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/audio-asr.log</string>
</dict>
</plist>
