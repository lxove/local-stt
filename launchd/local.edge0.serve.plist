<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.edge0.serve</string>
	<!-- Edge0 145B (Q3_K, Metal) via edge0-infer serve, OpenAI-kompatibelt API på 127.0.0.1:8080.
	     Byggt från __EDGE0__ (main 7b60076). Logg: ~/Library/Logs/edge0/serve.log
	     Stoppa:  launchctl bootout gui/$(id -u)/local.edge0.serve
	     Starta:  launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/local.edge0.serve.plist -->
	<key>ProgramArguments</key>
	<array>
		<string>__EDGE0__/edge0-infer/build/mac-metal/bin/edge0-infer</string>
		<string>serve</string>
		<string>--model</string>
		<string>__HOME__/models/Edge0-145B-q3k</string>
		<string>--host</string>
		<string>127.0.0.1</string>
		<string>--port</string>
		<string>8080</string>
		<!-- 128K: verifierat med nåltest vid ~125K (3/3), ~30 GB minnestopp. Mallens standard är 32K. -->
		<string>--context</string>
		<string>131072</string>
	</array>
	<key>WorkingDirectory</key>
	<string>__EDGE0__</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/edge0/serve.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/edge0/serve.log</string>
</dict>
</plist>
